<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jarvis Brain 3D</title>
<style>
  :root { --bg:#02030a; --ink:#e6e9f5; --muted:#8a90a8; --panel:rgba(12,14,28,.78); --line:rgba(255,255,255,.08); --accent:#ff7a18; }
  * { box-sizing:border-box; }
  html,body { margin:0; height:100%; background:var(--bg); color:var(--ink); font:14px/1.45 "Segoe UI", system-ui, sans-serif; overflow:hidden; }
  #graph { position:fixed; inset:0; }
  .hud { position:fixed; z-index:2; background:var(--panel); border:1px solid var(--line); border-radius:14px; backdrop-filter:blur(10px); }
  #title { top:16px; left:16px; padding:14px 16px; max-width:300px; }
  #title h1 { margin:0; font-size:18px; letter-spacing:.14em; text-transform:uppercase; }
  #title h1 span { color:var(--accent); }
  #title p { margin:4px 0 10px; color:var(--muted); font-size:12px; }
  #search { width:100%; padding:7px 10px; border-radius:8px; border:1px solid var(--line); background:rgba(255,255,255,.04); color:var(--ink); font:inherit; }
  #legend { list-style:none; margin:10px 0 0; padding:0; max-height:46vh; overflow:auto; }
  #legend li { display:flex; gap:8px; align-items:center; padding:3px 4px; border-radius:6px; cursor:pointer; font-size:12.5px; }
  #legend li:hover, #legend li.on { background:rgba(255,255,255,.07); }
  #legend i { width:10px; height:10px; border-radius:50%; flex:none; box-shadow:0 0 8px currentColor; }
  #legend small { color:var(--muted); margin-left:auto; }
  #info { right:16px; top:16px; width:340px; padding:16px; display:none; max-height:calc(100% - 32px); overflow:auto; }
  #info h2 { margin:0 0 2px; font-size:17px; }
  #info .tag { font-size:12px; color:var(--muted); margin-bottom:10px; }
  #info p { margin:8px 0; }
  #info ul { margin:6px 0 0; padding-left:18px; }
  #info li { margin:2px 0; cursor:pointer; }
  #info li:hover { color:#fff; text-decoration:underline; }
  #info a { color:var(--accent); }
  #info .close { position:absolute; right:10px; top:8px; background:none; border:0; color:var(--muted); font-size:20px; cursor:pointer; }
  #hint { left:50%; bottom:14px; transform:translateX(-50%); padding:6px 12px; font-size:12px; color:var(--muted); }
  @media (max-width:700px) {
    #title { left:16px; right:16px; max-width:none; }
    #legend { max-height:22vh; }
    #info { left:16px; right:16px; width:auto; top:auto; bottom:16px; max-height:45vh; }
    #hint { display:none; }
  }
</style>
</head>
<body>
<div id="graph"></div>
<div id="title" class="hud">
  <h1>Jarvis <span>Brain</span></h1>
  <p id="stats"></p>
  <input id="search" placeholder="Find a neuron…" autocomplete="off">
  <ul id="legend"></ul>
</div>
<div id="info" class="hud"><button class="close" aria-label="Close">×</button><div id="infoBody"></div></div>
<div id="hint" class="hud">drag to orbit · scroll to zoom · click a node · click a lobe to isolate it</div>

<script src="https://cdn.jsdelivr.net/npm/3d-force-graph@1"></script>
<script type="module">
const DATA = /*__DATA__*/null;
const byId = Object.fromEntries(DATA.nodes.map(n => [n.id, n]));
const lobeById = Object.fromEntries(DATA.lobes.map(l => [l.id, l]));
const nbrs = {};
DATA.links.forEach(l => { (nbrs[l.source] ||= []).push([l.target, l]); (nbrs[l.target] ||= []).push([l.source, l]); });

document.getElementById('stats').textContent =
  `${DATA.nodes.length} nodes · ${DATA.links.length} connections · ${DATA.lobes.length} lobes`;

let focusLobe = null, selected = null;
const hilite = new Set();

const Graph = ForceGraph3D({ controlType: 'orbit' })(document.getElementById('graph'))
  .backgroundColor('#02030a')
  .graphData({ nodes: DATA.nodes.map(n => ({ ...n })), links: DATA.links.map(l => ({ ...l })) })
  .nodeLabel(n => `<b>${esc(n.label)}</b><br><span style="opacity:.7">${esc(n.region)} · ${esc(n.lobe)}</span>`)
  .nodeColor(n => dim(n) ? 'rgba(90,95,120,0.25)' : n.color)
  .nodeVal(n => n.hub ? 4 + n.deg * 0.6 : 1.5 + n.deg * 0.6)
  .nodeResolution(16)
  .nodeOpacity(0.95)
  .linkColor(l => {
    const s = typeof l.source === 'object' ? l.source : byId[l.source];
    if (hilite.size) return hilite.has(s.id) && hilite.has((typeof l.target === 'object' ? l.target : byId[l.target]).id) ? '#ffffff' : 'rgba(120,130,170,0.06)';
    return focusLobe !== null && s.community !== focusLobe ? 'rgba(120,130,170,0.05)' : s.color;
  })
  .linkOpacity(0.28)
  .linkWidth(l => hilite.size && hilite.has(endId(l.source)) && hilite.has(endId(l.target)) ? 1.2 : 0.35)
  .linkDirectionalParticles(l => l.conf === 'EXTRACTED' ? 2 : 1)
  .linkDirectionalParticleWidth(1.6)
  .linkDirectionalParticleSpeed(() => 0.004 + Math.random() * 0.006)
  .linkDirectionalParticleColor(l => (typeof l.source === 'object' ? l.source : byId[l.source]).color)
  .onNodeClick(showNode)
  .onBackgroundClick(clearSel);

// Pull each lobe toward its region so the whole graph sits in a brain shape.
const SCALE = 1.35;
function lobeForce() {
  let nodes = [];
  function force(alpha) {
    for (const n of nodes) {
      const a = lobeById[n.community]?.anchor || [0, 0, 0];
      n.vx += (a[0] * SCALE - n.x) * 0.09 * alpha;
      n.vy += (a[1] * SCALE - n.y) * 0.09 * alpha;
      n.vz += (a[2] * SCALE - n.z) * 0.09 * alpha;
    }
  }
  force.initialize = ns => { nodes = ns; };
  return force;
}
Graph.d3Force('lobe', lobeForce());
Graph.d3Force('charge').strength(-38);
Graph.d3Force('link').distance(l => (endNode(l.source).community === endNode(l.target).community ? 18 : 60)).strength(0.25);
Graph.cameraPosition({ x: 0, y: 60, z: 420 });

// Glow (bloom). Page still works if the effect can't load.
try {
  const { UnrealBloomPass } = await import('https://esm.sh/three@0.170.0/examples/jsm/postprocessing/UnrealBloomPass.js');
  const bloom = new UnrealBloomPass();
  bloom.strength = 1.15; bloom.radius = 0.55; bloom.threshold = 0.08;
  Graph.postProcessingComposer().addPass(bloom);
} catch (e) { console.warn('Bloom unavailable', e); }

// Slow idle rotation, paused while the user is interacting.
let angle = 0, idle = true, idleTimer;
const el = document.getElementById('graph');
['pointerdown', 'wheel'].forEach(ev => el.addEventListener(ev, () => { idle = false; clearTimeout(idleTimer); idleTimer = setTimeout(() => idle = true, 8000); }));
(function spin() {
  if (idle && !selected) {
    angle += 0.0016;
    const d = 420;
    Graph.cameraPosition({ x: d * Math.sin(angle), y: 60, z: d * Math.cos(angle) });
  }
  requestAnimationFrame(spin);
})();

// Legend
const legend = document.getElementById('legend');
DATA.lobes.forEach(l => {
  const count = DATA.nodes.filter(n => n.community === l.id).length;
  const li = document.createElement('li');
  li.innerHTML = `<i style="color:${l.color};background:${l.color}"></i><span>${esc(l.name)}<br><span style="color:var(--muted);font-size:11px">${esc(l.region)}</span></span><small>${count}</small>`;
  li.onclick = () => {
    focusLobe = focusLobe === l.id ? null : l.id;
    [...legend.children].forEach(c => c.classList.remove('on'));
    if (focusLobe !== null) li.classList.add('on');
    refresh();
  };
  legend.appendChild(li);
});

// Search
document.getElementById('search').addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  const q = e.target.value.trim().toLowerCase();
  if (!q) return;
  const hit = Graph.graphData().nodes.find(n => n.label.toLowerCase().includes(q));
  if (hit) showNode(hit);
});

document.querySelector('#info .close').onclick = clearSel;

function showNode(n) {
  selected = n;
  hilite.clear(); hilite.add(n.id); (nbrs[n.id] || []).forEach(([o]) => hilite.add(o));
  const dist = 90, r = 1 + dist / Math.hypot(n.x, n.y, n.z);
  Graph.cameraPosition({ x: n.x * r, y: n.y * r, z: n.z * r }, n, 1200);
  const vault = encodeURIComponent('Kaydens Vault');
  const open = `obsidian://open?vault=${vault}&file=${encodeURIComponent(n.file)}`;
  const list = (nbrs[n.id] || []).map(([o, l]) =>
    `<li data-id="${esc(o)}">${esc(l.rel)} <b>${esc(byId[o].label)}</b>${l.conf === 'EXTRACTED' ? '' : ' <span style="opacity:.6">(inferred)</span>'}</li>`).join('');
  document.getElementById('infoBody').innerHTML = `
    <h2>${esc(n.label)}</h2>
    <div class="tag"><span style="color:${n.color}">●</span> ${esc(n.region)} · ${esc(n.lobe)}${n.hub ? ' · brain note' : ''}</div>
    ${n.summary ? `<p>${esc(n.summary)}</p>` : ''}
    ${n.why ? `<p><b>Why:</b> ${esc(n.why)}</p>` : ''}
    <p style="font-size:12px;color:var(--muted)">Source: ${esc(n.source)}</p>
    <p><a href="${open}">Open in Obsidian →</a></p>
    <b>${(nbrs[n.id] || []).length} connections</b><ul>${list}</ul>`;
  document.querySelectorAll('#infoBody li').forEach(li => li.onclick = () => showNode(Graph.graphData().nodes.find(x => x.id === li.dataset.id)));
  document.getElementById('info').style.display = 'block';
  refresh();
}
function clearSel() { selected = null; hilite.clear(); document.getElementById('info').style.display = 'none'; refresh(); }
function refresh() { Graph.nodeColor(Graph.nodeColor()).linkColor(Graph.linkColor()).linkWidth(Graph.linkWidth()); }
function dim(n) { return (hilite.size && !hilite.has(n.id)) || (!hilite.size && focusLobe !== null && n.community !== focusLobe); }
function endId(e) { return typeof e === 'object' ? e.id : e; }
function endNode(e) { return typeof e === 'object' ? e : byId[e]; }
function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
</script>
</body>
</html>
